# Build artifacts
/build/

# libdivecomputer: external clone (see README to clone / future submodule)
/vendor/libdivecomputer/

# Personal dive data (don't commit to git)
*.ddb
*.db
*.sqlite

# Flutter / Dart (once the project exists)
.flutter-plugins
.flutter-plugins-dependencies
.dart_tool/
.packages
.pub-cache/
.pub/
build/
*.iml
.gradle/
local.properties
key.properties
*.keystore
*.jks

# Google Drive OAuth Web client ID (not secret, but specific to your project)
android/gdrive_client_id.txt
android/gdrive_native_client_id.txt
linux/gdrive_desktop_client_id.txt
linux/gdrive_desktop_client_secret.txt

# Misc
.DS_Store

# The user's global gitignore ignores "tags" (ctags files); that hides the
# lib/features/tags/ feature. We re-include it here.
!lib/features/tags/
!lib/features/tags/**

# generated l10n (regenerated with flutter gen-l10n)
lib/l10n/app_localizations*.dart

# Reference material (DiveMate screenshots, not part of the app)
/reference/
