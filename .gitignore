/build/

# libdivecomputer: clon externo (ver README para clonar / futuro submodule)
/vendor/libdivecomputer/

# Datos personales de buceo (no subir a git)
*.ddb
*.db
*.sqlite

# Flutter / Dart (cuando exista el proyecto)
.flutter-plugins
.flutter-plugins-dependencies
.dart_tool/
.packages
.pub-cache/
